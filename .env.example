# Copy this file to .env and fill in one provider.
# The website works without any of these values by opening WhatsApp
# with the order pre-filled (the customer presses send).

# --- Meta WhatsApp Cloud API ---
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v21.0
WHATSAPP_TO=923113107375

# --- Twilio WhatsApp (alternative) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
